# /etc/fstab
# Replace the UUID placeholders with the values from:
#   blkid /dev/nvme0n1p1 /dev/nvme0n1p2
#
# <file system>                            <dir>   <type> <options>                                                                                       <dump> <pass>
UUID=<ROOT_UUID>                           /       xfs    rw,relatime,inode64,logbufs=8,logbsize=32k,noquota                                              0      1
UUID=<ESP_UUID>                            /boot   vfat   rw,relatime,fmask=0177,dmask=0077,codepage=437,iocharset=ascii,shortname=mixed,utf8,errors=remount-ro  0      2
